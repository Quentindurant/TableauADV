{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "moduleNameMapper": {
    "^@suivi/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
  },
  "setupFiles": ["dotenv/config"],
  "maxWorkers": 1
}
